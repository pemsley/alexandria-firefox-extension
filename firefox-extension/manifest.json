{
  "manifest_version": 2,
  "name": "Save to Alexandria",
  "version": "0.1.0",
  "description": "Save the article PDF on the current page into the Alexandria library directory.",

  "browser_specific_settings": {
    "gecko": {
      "id": "alexandria-connector@pemsley.github.io",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "nativeMessaging",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["pdf-url.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pdf-url.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_title": "Alexandria connector: No PDF detected",
    "default_icon": {
      "32": "icons/alexandria-32-grey.png"
    },
    "default_popup": null
  }
}
